# Local dev — copy to .env.local (never commit .env.local)

# GitHub Pages project site (must match deploy workflow if used locally)
# Apex domain: omit BASE_PATH. Legacy github.io only:
# NEXT_PUBLIC_BASE_PATH=/MosaicBot_StockContext
# NEXT_PUBLIC_SITE_URL=https://stockcontext.info

# CDN root for published JSON
# NEXT_PUBLIC_DATA_BASE_URL=https://storage.stockthemes.ai/stockcontext/

# Same Supabase project as stockthemes.ai (Google / magic link + read state sync)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional: OAuth buttons (default google). Use none for email-only.
# NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=google
# NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=google,github
# NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=none
