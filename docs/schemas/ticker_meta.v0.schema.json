{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockcontext.ai/schemas/ticker_meta.v0.json",
  "title": "stockcontext ticker meta v0",
  "description": "Lightweight ticker header for /ticker/[symbol] initial paint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "symbol", "as_of"],
  "properties": {
    "schema_version": { "type": "integer", "const": 0 },
    "symbol": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "minLength": 1 },
    "build_id": { "type": "string" },
    "company_name": { "type": "string" },
    "logo_url": {
      "type": "string",
      "format": "uri",
      "description": "Public logo image URL from mosaic ETL (optional)"
    },
    "exchange": { "type": "string" },
    "tier": { "type": "integer", "enum": [1, 2, 3] },
    "portfolio_weight": { "type": ["number", "null"] },
    "primary_theme": { "type": "string" },
    "themes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_earnings_date": { "type": ["string", "null"], "description": "YYYY-MM-DD" },
    "last_earnings_date": { "type": ["string", "null"] },
    "earnings_timing": { "type": ["string", "null"], "enum": ["BMO", "AMC", null] },
    "workflow_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["pre_earnings_ready", "notes_pending"]
      }
    },
    "last_updated_at": { "type": "string" },
    "chart_url": {
      "type": "string",
      "description": "Relative path to chart_1y.v0.json"
    },
    "financials_url": { "type": "string" },
    "tables_index_url": { "type": "string" }
  }
}
