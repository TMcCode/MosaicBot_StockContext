{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockcontext.ai/schemas/search_index.v0.json",
  "title": "stockcontext search index v0",
  "description": "Deterministic search/browse payload for Stock Context. Client fuse text is built from symbol, company_name, theme_names, slug, and name — search_text is deprecated legacy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "tickers"],
  "properties": {
    "schema_version": { "type": "integer", "const": 0 },
    "as_of": { "type": "string", "minLength": 1 },
    "build_id": { "type": "string" },
    "tickers": {
      "type": "array",
      "items": { "$ref": "#/$defs/tickerRow" }
    },
    "themes": {
      "type": "array",
      "items": { "$ref": "#/$defs/themeRow" }
    }
  },
  "$defs": {
    "themeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "search_text": {
          "type": "string",
          "deprecated": true,
          "description": "Legacy; omit on publish. Client uses slug + name."
        },
        "ticker_count": { "type": "integer" },
        "constituents_with_data": { "type": "integer" },
        "has_table_data": { "type": "boolean" },
        "meta_url": { "type": ["string", "null"] }
      }
    },
    "tickerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "company_name": { "type": "string" },
        "search_text": {
          "type": "string",
          "deprecated": true,
          "description": "Legacy; omit on publish. Client uses symbol, company_name, theme_names."
        },
        "tier": { "type": "integer", "enum": [1, 2, 3] },
        "theme_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "meta_url": { "type": "string" },
        "last_updated_at": {
          "type": "string",
          "description": "ISO 8601 — max of text table / note updates"
        }
      }
    }
  }
}
