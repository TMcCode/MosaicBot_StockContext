{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockcontext.ai/schemas/home_feeds.v0.json",
  "title": "stockcontext home feeds v0",
  "description": "Home page sections: movers, watchlist by update, recent notes/transcripts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "sections"],
  "properties": {
    "schema_version": { "type": "integer", "const": 0 },
    "as_of": { "type": "string", "minLength": 1 },
    "build_id": { "type": "string" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "items"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "focus_list",
            "top_abs_10d",
            "watchlist_by_update",
            "recent_transcripts_notes",
            "watchlist_themes",
            "portfolio_themes",
            "recently_reported",
            "upcoming_earnings",
            "theme_10d_outperformers",
            "theme_10d_underperformers",
            "ticker_10d_outperformers",
            "ticker_10d_underperformers",
            "universe"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/feedItem" }
        }
      }
    },
    "feedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "label"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "sublabel": { "type": "string" },
        "badge": {
          "type": ["string", "null"],
          "enum": ["pending", "ready", null]
        },
        "metric": {
          "type": ["number", "null"],
          "description": "e.g. 10D return % for movers"
        },
        "event_at": {
          "type": ["string", "null"],
          "description": "ISO 8601 sort key"
        },
        "meta_url": { "type": "string" }
      }
    }
  }
}
